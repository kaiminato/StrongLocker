<Window x:Class="StrongLocker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StrongLocker Settings"
        Width="560" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <!-- Palette -->
        <Color x:Key="AccentColor">#6366F1</Color>
        <SolidColorBrush x:Key="Bg" Color="#16161C"/>
        <SolidColorBrush x:Key="Card" Color="#1E1E26"/>
        <SolidColorBrush x:Key="Input" Color="#2A2A33"/>
        <SolidColorBrush x:Key="InputHover" Color="#33333F"/>
        <SolidColorBrush x:Key="Border" Color="#3A3A46"/>
        <SolidColorBrush x:Key="Text" Color="#ECECF2"/>
        <SolidColorBrush x:Key="SubText" Color="#9AA0B5"/>
        <SolidColorBrush x:Key="Accent" Color="#6366F1"/>
        <SolidColorBrush x:Key="AccentHover" Color="#7A7CF5"/>

        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- Card -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{StaticResource Input}" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource InputHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="b" Background="{StaticResource Input}" CornerRadius="8" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource InputHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary / ghost button -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource Input}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource InputHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hotkey capture field (a Button so it can take keyboard focus) -->
        <Style x:Key="HotkeyButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="hb" Background="{StaticResource Input}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hb" Property="Background" Value="{StaticResource InputHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="hb" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                                    Background="{StaticResource Input}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                <Path x:Name="check" Data="M4,10 L8,14 L15,5" Stroke="White" StrokeThickness="2"
                                      Stretch="Uniform" Margin="3" Visibility="Collapsed"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem (readable) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" CornerRadius="6" Margin="4,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource InputHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox (readable, dark popup) -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="b" Background="{StaticResource Input}" CornerRadius="8" Padding="12,0">
                                            <Grid>
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Data="M0,0 L5,5 L10,0" Stroke="{StaticResource SubText}" StrokeThickness="1.6"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource InputHover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,32,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource Input}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Root card with shadow -->
    <Border Background="{StaticResource Bg}" CornerRadius="16" Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>
        <DockPanel Margin="0">
            <!-- Title bar -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="52" Background="Transparent">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Accent}">
                        <Path Data="M6,11 L6,8 A4,4 0 0 1 14,8 L14,11 M4,11 L16,11 L16,17 L4,17 Z"
                              Stroke="White" StrokeThickness="1.4" Fill="#33FFFFFF" Stretch="Uniform" Margin="5"/>
                    </Border>
                    <TextBlock Text="StrongLocker" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0"/>
                    <TextBlock Text="Settings" FontSize="15" Opacity="0.5" Margin="6,0,0,0"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Content="&#x2715;" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,14,0" Width="32" Height="32" Style="{StaticResource GhostButton}"
                        Padding="0" FontSize="13" Click="Cancel_Click"/>
            </Grid>

            <!-- Footer -->
            <Grid DockPanel.Dock="Bottom" Margin="20,8,20,20">
                <TextBlock x:Name="StatusText" Foreground="#FF8080" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="96" Style="{StaticResource GhostButton}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Save" Width="110" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>

            <!-- Scrollable content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,4,20,4">
                <StackPanel>
                    <!-- Password -->
                    <StackPanel>
                        <TextBlock Text="PASSWORD" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock x:Name="PwHint" Text="Set a password to enable locking." Foreground="{StaticResource SubText}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" x:Name="CurrentPwLabel" Text="Current password" Margin="0,6"/>
                                    <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="CurrentPw" Margin="0,6"/>
                                    <TextBlock Grid.Row="1" Text="New password" Margin="0,6"/>
                                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="NewPw" Margin="0,6"/>
                                    <TextBlock Grid.Row="2" Text="Confirm password" Margin="0,6"/>
                                    <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ConfirmPw" Margin="0,6"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Hotkey -->
                    <StackPanel>
                        <TextBlock Text="LOCK HOTKEY" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Click the field and press your shortcut." Foreground="{StaticResource SubText}" Margin="0,0,0,10"/>
                                <Button x:Name="HotkeyBox" Height="40" Style="{StaticResource HotkeyButton}"
                                        GotFocus="HotkeyBox_GotFocus" LostFocus="HotkeyBox_LostFocus"
                                        PreviewKeyDown="HotkeyBox_PreviewKeyDown">
                                    <TextBlock x:Name="HotkeyText" Text="Ctrl+Alt+L" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Idle -->
                    <StackPanel>
                        <TextBlock Text="AUTO-LOCK ON IDLE" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="IdleEnabled" Content="Lock after" VerticalAlignment="Center"/>
                                <TextBox x:Name="IdleMinutes" Width="56" Margin="12,0"/>
                                <TextBlock Text="minutes idle" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Background" Width="100"/>
                                    <ComboBox x:Name="BgCombo" Width="240" SelectionChanged="BgCombo_SelectionChanged"/>
                                </StackPanel>

                                <!-- Blur strength (blur mode) -->
                                <StackPanel x:Name="BlurRow" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Blur amount" Width="100"/>
                                    <Slider x:Name="BlurSlider" Width="220" Minimum="1" Maximum="40"
                                            TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BlurValue" Width="44" Margin="10,0,0,0"/>
                                </StackPanel>

                                <!-- Solid color (solid mode) -->
                                <StackPanel x:Name="ColorRow" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Color" Width="100"/>
                                    <Border Width="34" Height="30" CornerRadius="7" Margin="0,0,10,0" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <Border.Background><SolidColorBrush x:Name="ColorSwatch" Color="#1E1E24"/></Border.Background>
                                    </Border>
                                    <TextBox x:Name="SolidColor" Width="140" TextChanged="SolidColor_TextChanged"/>
                                    <TextBlock Text=" #RRGGBB" Foreground="{StaticResource SubText}"/>
                                </StackPanel>

                                <!-- Image (image mode) -->
                                <StackPanel x:Name="ImageRow" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="Image" Width="100"/>
                                    <TextBox x:Name="ImagePath" Width="250"/>
                                    <Button Content="Browse" Style="{StaticResource GhostButton}" Width="80" Margin="8,0,0,0" Click="BrowseImage_Click"/>
                                </StackPanel>

                                <!-- Common: darken + clock -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Darken" Width="100"/>
                                    <Slider x:Name="TintSlider" Width="220" Minimum="0" Maximum="100"
                                            TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TintValue" Width="44" Margin="10,0,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ShowClock" Content="Show clock"/>
                                <CheckBox x:Name="Clock24" Content="24-hour clock"/>

                                <Button Content="Preview" Style="{StaticResource GhostButton}" Width="120"
                                        HorizontalAlignment="Left" Margin="0,14,0,0" Click="Preview_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Behavior -->
                    <StackPanel>
                        <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="RunOnStartup" Content="Run on startup (launch at Windows login)"/>
                                <CheckBox x:Name="LockOnStartup" Content="Lock immediately when StrongLocker starts"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
